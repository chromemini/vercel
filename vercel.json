{
  "functions": {
    "api/cf-bridge.js": {
      "runtime": "edge"
    }
  },
  "headers": [
    {
      "source": "/api/cf-bridge",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, X-CF-Account-Id, X-CF-Api-Token" },
        { "key": "Access-Control-Max-Age", "value": "86400" }
      ]
    }
  ]
}